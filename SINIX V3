-- ─── KEY VALIDATION ───────────────────────────────────────────────────────────

local validating = false
local function validateKey()
    if validating then return end
    validating = true

    local dots = 0
    local dotConn
    typingLabel.Text = "Vérification"
    errorLabel.Text  = ""
    dotConn = RunService.Heartbeat:Connect(function()
        dots = (dots + 1) % 4
        typingLabel.Text = "Vérification" .. string.rep(".", dots)
    end)
    task.wait(0.65)
    dotConn:Disconnect()
    typingLabel.Text = ""

    local text = inputBox.Text:gsub("%s+", "")
    if text == KEY then
        lgStroke.Color = baseColors.success
        task.wait(0.2)
        spawnParticles(LoginFrame)
        task.wait(0.35)
        local fade = TweenService:Create(LoginFrame,
            TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { BackgroundTransparency = 1, Size = UDim2.new(0, 240, 0, 180) })
        fade:Play()
        fade.Completed:Wait()
        LoginFrame:Destroy()
        menuUnlocked = true
        openMenuAnimation()
        if firstTabButton then
            selectTab(firstTabButton, tabsData[1].func, tabsData[1].label)
        end
        showToast("✓  Accès accordé — bienvenue !", baseColors.success)
    else
        validating = false
        errorLabel.Text = "❌  Clé invalide, réessaye !"
        local orig = LoginFrame.Position
        local seq  = { -14, 14, -9, 9, -4, 0 }
        for _, ox in ipairs(seq) do
            TweenService:Create(LoginFrame,
                TweenInfo.new(0.044, Enum.EasingStyle.Linear),
                { Position = UDim2.new(0.5, ox, 0.5, 0) }):Play()
            task.wait(0.048)
        end
        LoginFrame.Position = orig
    end
end

loginButton.MouseButton1Click:Connect(validateKey)
inputBox.FocusLost:Connect(function(ep) if ep then validateKey() end end)

openLoginFrameAnimation()
