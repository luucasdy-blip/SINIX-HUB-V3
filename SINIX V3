local selectedTabButton   = nil
local tabTransitionActive = false

local function clearContent()
    for _, child in ipairs(ContentFrame:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
end

local function selectTab(button, contentFunc, tabLabel)
    if tabTransitionActive then return end
    tabTransitionActive = true

    if chTitle then chTitle.Text = tabLabel or "  " end

    if selectedTabButton and selectedTabButton ~= button then
        selectedTabButton.BackgroundColor3    = Color3.fromRGB(0,0,0)
        selectedTabButton.BackgroundTransparency = 0.7
        for _, ch in ipairs(selectedTabButton:GetChildren()) do
            if ch:IsA("Frame") and ch.Name == "ActiveBar" then ch:Destroy() end
        end
    end

    selectedTabButton = button
    TweenService:Create(button,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad),
        { BackgroundColor3 = baseColors.accent, BackgroundTransparency = 0 }):Play()

    -- Active left-side bar
    local activeBar = button:FindFirstChild("ActiveBar") or Instance.new("Frame")
    activeBar.Name             = "ActiveBar"
    activeBar.Size             = UDim2.new(0, 3, 0.7, 0)
    activeBar.Position         = UDim2.new(0, 0, 0.15, 0)
    activeBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    activeBar.BorderSizePixel  = 0
    activeBar.ZIndex           = button.ZIndex + 1
    activeBar.Parent           = button
    addRainbow(activeBar, "BackgroundColor3")
    local abCorner = Instance.new("UICorner")
    abCorner.CornerRadius = UDim.new(0, 2)
    abCorner.Parent       = activeBar

    local fadeOut = TweenService:Create(ContentFrame,
        TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = UDim2.new(0.06, 0, 0, 48) })
    fadeOut:Play()
    fadeOut.Completed:Wait()

    clearContent()
    contentFunc()
    ContentFrame.Position = UDim2.new(-0.06, 0, 0, 48)

    local fadeIn = TweenService:Create(ContentFrame,
        TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Position = UDim2.new(0, 0, 0, 48) })
    fadeIn:Play()
    fadeIn.Completed:Wait()
    tabTransitionActive = false
end

