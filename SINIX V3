local function safeLoad(btn, originalText, url, useCache)
    if not btn then return end
    btn.Text   = "⏳  Chargement..."
    btn.Active = false

    local bar = Instance.new("Frame")
    bar.Size                   = UDim2.new(0, 0, 1, 0)
    bar.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
    bar.BackgroundTransparency = 0.7
    bar.BorderSizePixel        = 0
    bar.ZIndex                 = btn.ZIndex + 1
    bar.Parent                 = btn
    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 6)
    bc.Parent       = bar

    TweenService:Create(bar,
        TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
        { Size = UDim2.new(1, 0, 1, 0) }):Play()

    task.spawn(function()
        local ok, result = pcall(function()
            return loadstring(game:HttpGet(url, useCache))()
        end)
        task.wait(0.4)
        if btn and btn.Parent then
            btn.Text   = originalText
            btn.Active = true
            for _, ch in ipairs(btn:GetChildren()) do
                if ch:IsA("Frame") then ch:Destroy() end
            end
        end
        showToast(
            ok and ("✓  " .. originalText:gsub("[^%a%s]",""):gsub("^%s+","") .. " lancé !")
               or "✗  Erreur de chargement",
            ok and baseColors.success or baseColors.error
        )
        if not ok then warn("[SinixOnTop] " .. tostring(result)) end
    end)
end

