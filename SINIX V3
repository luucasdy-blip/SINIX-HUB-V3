-- ─── RAINBOW / PULSE ──────────────────────────────────────────────────────────

local hue = 0
local rainbowObjects = {}
local pulseObjects   = {}
local pulseT         = 0

local function getRainbowColor()
    hue = (hue + 1) % 360
    return Color3.fromHSV(hue / 360, 0.85, 1)
end

local function addRainbow(obj, prop)
    table.insert(rainbowObjects, { obj = obj, prop = prop })
end

local function removeRainbow(targetObj, targetProp)
    for i = #rainbowObjects, 1, -1 do
        local e = rainbowObjects[i]
        if e.obj == targetObj and e.prop == targetProp then
            table.remove(rainbowObjects, i)
        end
    end
end

local function addPulse(stroke)
    table.insert(pulseObjects, stroke)
end

RunService.Heartbeat:Connect(function(dt)
    local color = getRainbowColor()
    for i = #rainbowObjects, 1, -1 do
        local e = rainbowObjects[i]
        if e.obj and e.obj.Parent then e.obj[e.prop] = color
        else table.remove(rainbowObjects, i) end
    end
    pulseT = pulseT + dt * 2
    local thickness = 2 + math.sin(pulseT) * 1.5
    for i = #pulseObjects, 1, -1 do
        local s = pulseObjects[i]
        if s and s.Parent then s.Thickness = thickness
        else table.remove(pulseObjects, i) end
    end
end)

-- ─── HELPERS UI ───────────────────────────────────────────────────────────────

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent       = parent
    return c
end

local function stroke(parent, thickness, color)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1.5
    if color then s.Color = color end
    s.Parent = parent
    return s
end

local function label(parent, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.BorderSizePixel        = 0
    for k, v in pairs(props) do l[k] = v end
    l.Parent = parent
    return l
end

local function addHoverScale(obj, scaleUp)
    scaleUp = scaleUp or 1.05
    local sc = Instance.new("UIScale")
    sc.Scale  = 1
    sc.Parent = obj
    obj.MouseEnter:Connect(function()
        TweenService:Create(sc, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = scaleUp }):Play()
    end)
    obj.MouseLeave:Connect(function()
        TweenService:Create(sc, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.0 }):Play()
    end)
end

local function addRipple(btn)
    btn.MouseButton1Click:Connect(function()
        local r = Instance.new("Frame")
        r.Size = UDim2.new(0, 0, 0, 0)
        r.AnchorPoint            = Vector2.new(0.5, 0.5)
        r.Position               = UDim2.new(0.5, 0, 0.5, 0)
        r.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
        r.BackgroundTransparency = 0.65
        r.BorderSizePixel        = 0
        r.ZIndex                 = btn.ZIndex + 2
        r.Parent                 = btn
        corner(r, 1000)
        local t = TweenService:Create(r, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = UDim2.new(2.5, 0, 2.5, 0), BackgroundTransparency = 1 })
        t:Play()
        t.Completed:Connect(function() r:Destroy() end)
    end)
end

local function makeRainbowHover(button)
    button.MouseEnter:Connect(function()
        task.spawn(function()
            while button:IsMouseOver() and button.Parent do
                button.BackgroundColor3 = getRainbowColor()
                task.wait(0.03)
            end
            if button and button.Parent then
                button.BackgroundColor3 = baseColors.button
            end
        end)
    end)
    button.MouseLeave:Connect(function()
        if button and button.Parent then
            button.BackgroundColor3 = baseColors.button
        end
    end)
    addHoverScale(button)
    addRipple(button)
end

-- ─── TOAST ────────────────────────────────────────────────────────────────────

local toastQueue   = {}
local toastRunning = false
local ScreenGui

local function showToast(message, color)
    table.insert(toastQueue, { msg = message, col = color or baseColors.success })
    if toastRunning then return end
    toastRunning = true
    task.spawn(function()
        while #toastQueue > 0 do
            local entry = table.remove(toastQueue, 1)
            local toast = Instance.new("Frame")
            toast.Size                   = UDim2.new(0, 0, 0, 50)
            toast.Position               = UDim2.new(0.5, 0, 1, -70)
            toast.AnchorPoint            = Vector2.new(0.5, 1)
            toast.BackgroundColor3       = entry.col
            toast.BackgroundTransparency = 0.1
            toast.BorderSizePixel        = 0
            toast.ZIndex                 = 60
            toast.Parent                 = ScreenGui
            corner(toast, 10)
            local strip = Instance.new("Frame")
            strip.Size                   = UDim2.new(0, 4, 1, 0)
            strip.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
            strip.BackgroundTransparency = 0.3
            strip.BorderSizePixel        = 0
            strip.ZIndex                 = 61
            strip.Parent                 = toast
            corner(strip, 4)
            label(toast, {
                Size           = UDim2.new(1, -24, 1, 0),
                Position       = UDim2.new(0, 14, 0, 0),
                Font           = Enum.Font.GothamBold,
                TextSize       = 15,
                TextColor3     = Color3.fromRGB(255, 255, 255),
                TextXAlignment = Enum.TextXAlignment.Left,
                Text           = entry.msg,
                ZIndex         = 62,
            })
            TweenService:Create(toast, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { Size = UDim2.new(0, 380, 0, 50) }):Play()
            task.wait(2.8)
            local out = TweenService:Create(toast, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { Size = UDim2.new(0, 0, 0, 50), BackgroundTransparency = 1 })
            out:Play()
            out.Completed:Wait()
            toast:Destroy()
            task.wait(0.08)
        end
        toastRunning = false
    end)
end

local function spawnParticles(parent)
    for i = 1, 24 do
        local p = Instance.new("Frame")
        local sz = math.random(4, 14)
        p.Size                   = UDim2.new(0, sz, 0, sz)
        p.Position               = UDim2.new(0.5, 0, 0.5, 0)
        p.AnchorPoint            = Vector2.new(0.5, 0.5)
        p.BackgroundColor3       = Color3.fromHSV(math.random(), 1, 1)
        p.BackgroundTransparency = 0
        p.BorderSizePixel        = 0
        p.ZIndex                 = 20
        p.Parent                 = parent
        corner(p, 1000)
        local angle = (i / 24) * math.pi * 2 + math.random() * 0.5
        local dist  = math.random(90, 260)
        local t = TweenService:Create(p,
            TweenInfo.new(0.7 + math.random() * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Position     = UDim2.new(0.5, math.cos(angle) * dist, 0.5, math.sin(angle) * dist),
              BackgroundTransparency = 1,
              Size          = UDim2.new(0, 0, 0, 0) })
        t:Play()
        t.Completed:Connect(function() p:Destroy() end)
    end
end

