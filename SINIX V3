            lbl.TextXAlignment         = Enum.TextXAlignment.Left
            lbl.Text                   = entry.msg
            lbl.ZIndex                 = 62
            lbl.Parent                 = toast

            TweenService:Create(toast,
                TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { Size = UDim2.new(0, 360, 0, 50) }):Play()
            task.wait(2.8)
            local out = TweenService:Create(toast,
                TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { Size = UDim2.new(0, 0, 0, 50), BackgroundTransparency = 1 })
            out:Play()
            out.Completed:Wait()
            toast:Destroy()
            task.wait(0.08)
        end
        toastRunning = false
    end)
