local function createSlider(labelText, minVal, maxVal, defaultVal, order, callback)
    local current = defaultVal or minVal

    local wrapper = Instance.new("Frame")
    wrapper.Size             = UDim2.new(1, 0, 0, 70)
    wrapper.BackgroundColor3 = baseColors.button
    wrapper.BorderSizePixel  = 0
    wrapper.LayoutOrder      = order
    wrapper.ZIndex           = 5
    wrapper.Parent           = ContentFrame
    corner(wrapper, 10)
    stroke(wrapper, 1, Color3.fromRGB(55, 55, 78))

    label(wrapper, {
        Size           = UDim2.new(1, -80, 0, 22),
        Position       = UDim2.new(0, 14, 0, 8),
        Font           = Enum.Font.GothamBold,
        TextSize       = 14,
        TextColor3     = baseColors.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text           = labelText,
        ZIndex         = 6,
    })

    local valLbl = label(wrapper, {
        Size           = UDim2.new(0, 60, 0, 22),
        Position       = UDim2.new(1, -74, 0, 8),
        Font           = Enum.Font.GothamBold,
        TextSize       = 14,
        TextColor3     = baseColors.accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text           = tostring(current),
        ZIndex         = 6,
    })
    addRainbow(valLbl, "TextColor3")

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, -28, 0, 6)
    track.Position         = UDim2.new(0, 14, 0, 44)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    track.BorderSizePixel  = 0
    track.ZIndex           = 6
    track.Parent           = wrapper
    corner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((current - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = baseColors.accent
    fill.BorderSizePixel  = 0
    fill.ZIndex           = 7
    fill.Parent           = track
    corner(fill, 3)
    addRainbow(fill, "BackgroundColor3")

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0, 16, 0, 16)
    thumb.AnchorPoint      = Vector2.new(0.5, 0.5)
    thumb.Position         = UDim2.new((current - minVal) / (maxVal - minVal), 0, 0.5, 0)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel  = 0
    thumb.ZIndex           = 8
    thumb.Parent           = track
    corner(thumb, 8)

    local dragging = false

    local function updateValue(absX)
        local trackAbsPos  = track.AbsolutePosition.X
        local trackAbsSize = track.AbsoluteSize.X
        local ratio = math.clamp((absX - trackAbsPos) / trackAbsSize, 0, 1)
        current        = math.floor(minVal + ratio * (maxVal - minVal))
        valLbl.Text    = tostring(current)
        fill.Size      = UDim2.new(ratio, 0, 1, 0)
        thumb.Position = UDim2.new(ratio, 0, 0.5, 0)
        if callback then callback(current) end
    end

    local clickArea = Instance.new("TextButton")
    clickArea.Size                   = UDim2.new(1, 0, 1, 0)
    clickArea.BackgroundTransparency = 1
    clickArea.Text                   = ""
    clickArea.ZIndex                 = 9
    clickArea.Parent                 = track

    clickArea.MouseButton1Down:Connect(function()
        dragging = true
        updateValue(UserInputService:GetMouseLocation().X)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateValue(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return wrapper
end

